[Trigger]
Type = Path
Operation = Install
Operation = Remove 
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Path
Operation = Install
Operation = Remove
Target = boot/memtest86+/*

[Trigger]
Operation = Upgrade
Operation = Install
Type = Package
Target = grub

[Action]
Description = Updating grub configuration file... 
When = PostTransaction
Depends = grub
Exec = /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg
