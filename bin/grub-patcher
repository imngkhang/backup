#!/usr/bin/env python3 
import sys

target_file = "/etc/grub.d/10_linux"

old_block_linux = '  sed "s/^/$submenu_indentation/" << EOF\n\techo\t\'$(echo "$message" | grub_quote)\'\n\tlinux\t${rel_dirname}/${basename} root=${linux_root_device_thisversion} rw ${args}\nEOF'

new_block_linux = '''  if [ x"$quiet_boot" = x0 ] || [ x"$type" != xsimple ]; then
    sed "s/^/$submenu_indentation/" << EOF
\t  echo\t  '$(echo "$message" | grub_quote)'
\t  linux\t  ${rel_dirname}/${basename} root=${linux_root_device_thisversion} rw ${args}
EOF
  else
    sed "s/^/$submenu_indentation/" << EOF
\t  linux\t  ${rel_dirname}/${basename} root=${linux_root_device_thisversion} rw ${args}
EOF

  fi'''

old_block_initrd = '  sed "s/^/$submenu_indentation/" << EOF\n\techo\t\'$(echo "$message" | grub_quote)\'\n\tinitrd\t$(echo $initrd_path)\nEOF'

new_block_initrd = '''    if [ x"$quiet_boot" = x0 ] || [ x"$type" != xsimple ]; then
      sed "s/^/$submenu_indentation/" << EOF
\t  echo\t       '$(echo "$message" | grub_quote)'
\t  initrd\t$(echo $initrd_path)
EOF
    else
      sed "s/^/$submenu_indentation/" << EOF
\t  initrd\t$(echo $initrd_path)
EOF
    fi'''

try:
    with open(target_file, "r", encoding="utf-8") as f:
        content = f.read()

    modified = False

    if old_block_linux in content:
        content = content.replace(old_block_linux, new_block_linux)
        modified = True

    if old_block_initrd in content:
        content = content.replace(old_block_initrd, new_block_initrd)
        modified = True

    if modified:
        with open(target_file, "w", encoding="utf-8") as f:
            f.write(content)
        print("Replace blocks successfully!")
        sys.exit(0)
    else:
        print("Error: Can't find matching old_block blocks in file!")
        sys.exit(1)
except Exception as e:
    print(f"System error: {e}")
    sys.exit(1)
